# Sui network WalrusStore connects to (mainnet | testnet | devnet | localnet)
SUI_NETWORK=testnet

# Deployed tusk_contracts package + shared Registry object id.
# See packages/contracts/NOTES.md for the current deployment.
SUI_PACKAGE_ID=0xa91c711fe09a79f7306fa86377051abfdacd3fa4e2bb89d06ff74ddf2953fb89
SUI_REGISTRY_ID=0x558d762df929740ef5d48aa5384a95cad443f503c1706a2199501f1083c98ca9

# Walrus HTTP API endpoints (testnet defaults shown)
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# Bech32-encoded Sui private key (starts with "suiprivkey1...") for the
# signer that pays gas and anchors entries/tasks on chain. Must hold testnet
# SUI. Generate with `sui client new-address ed25519` + `sui keytool export`,
# or `Ed25519Keypair.getSecretKey()`. NEVER commit a real value here.
SUI_PRIVATE_KEY=suiprivkey1...

# Set to "1" to run the WalrusStore integration suite (src/__tests__/walrus.integration.test.ts)
# against the network/contracts/account configured above. Requires all of the
# variables above to be set with real values in a local .env file.
RUN_WALRUS_INTEGRATION=
