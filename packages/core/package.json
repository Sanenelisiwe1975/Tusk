{
  "name": "@tusk/core",
  "version": "0.1.0",
  "description": "Tusk shared memory contract: types, MemoryStore interface, in-memory reference implementation, and Walrus skeleton",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example": "tsx examples/run.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "dotenv": "^17.4.2",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@mysten/sui": "1.45.2"
  }
}
