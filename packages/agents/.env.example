# Anthropic API key used by AnthropicLLM (packages/agents/src/llm.ts).
# When set, makeLLM() returns a real AnthropicLLM; when unset, it falls back
# to FakeLLM so tests and local runs work offline. Get a key from
# https://console.anthropic.com/. NEVER commit a real value here.
ANTHROPIC_API_KEY=sk-ant-...
