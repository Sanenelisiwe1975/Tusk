# MemoryScope — Vite environment variables
# Copy this file to .env (gitignored) and set values as needed.
# NEVER commit a real .env — it could contain a private key from another tool.

# Backend: 'memory' (default) — in-process InMemoryStore seeded with demo data.
#          'walrus' — live Sui testnet + Walrus aggregator (read-only).
#          If 'walrus' is set but the network is unreachable, MemoryScope
#          automatically falls back to InMemoryStore so the demo keeps running.
VITE_TUSK_BACKEND=memory

# Presentation mode: set to '1' to enter judge-facing layout.
# Hides the sidebar and the simulate-write dev button; widens the detail pane
# so the VERIFIED badge is front-and-centre. Use the Deck tab for pitch slides.
# Works on both backends (walrus or memory fallback).
VITE_TUSK_PRESENT=

# ── Walrus backend (required when VITE_TUSK_BACKEND=walrus) ──────────────────
#
# MemoryScope is READ-ONLY. It calls list / read / listTasks / verify / watch
# only — never write / createTask / claimTask / completeTask / failTask.
# No private key is needed: reads go through the public Walrus aggregator and
# public Sui RPC; devInspect (used by read/verify) only needs a valid Sui
# address as a simulation sender, which MemoryScope generates as a throwaway
# keypair at startup.

# Sui network the package was deployed to. testnet is the default.
VITE_SUI_NETWORK=testnet

# Deployed package ID — from packages/contracts/Published.toml or NOTES.md.
VITE_SUI_PACKAGE_ID=0xa91c711fe09a79f7306fa86377051abfdacd3fa4e2bb89d06ff74ddf2953fb89

# Shared Registry object ID — created by registry::init at publish time.
VITE_SUI_REGISTRY_ID=0x558d762df929740ef5d48aa5384a95cad443f503c1706a2199501f1083c98ca9

# Walrus aggregator URL (read path only; the publisher URL is unused by MemoryScope).
# Testnet default is pre-filled; leave unset to use it.
VITE_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# The demo run namespace agents write to. MemoryScope discovers namespaces
# automatically via list(), so this is informational only — you do not need to
# set it in the app, but it's useful to know which namespace to look for.
# VITE_TUSK_DEMO_NAMESPACE=demo
